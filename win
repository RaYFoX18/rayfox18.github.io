$CmbUnidadesUsb = $Ventana.FindName("CmbUnidadesUsb");
$BtnRefrescarUsb = $Ventana.FindName("BtnRefrescarUsb");
$RbGPT = $Ventana.FindName("RbGPT");
$RbMBR = $Ventana.FindName("RbMBR");
$ChkBypassWin11 = $Ventana.FindName("ChkBypassWin11");
$BtnIniciarBooteo = $Ventana.FindName("BtnIniciarBooteo");
$BtnAbrirRufus = $Ventana.FindName("BtnAbrirRufus");
$TxtEstadoBooteo = $Ventana.FindName("TxtEstadoBooteo");

$ListaCheckboxes = @();

function Actualizar-Contador {
    $Total = ($ListaCheckboxes.Where({ $_.IsChecked -eq $true })).Count;
    $TxtContador.Text = "Seleccionados: $Total";
}

# 3. GENERAR CATEGORIAS Y TARJETAS EN LA INTERFAZ
foreach ($Cat in $Categorias.Keys) {
    $Grupo = New-Object System.Windows.Controls.GroupBox;
    $Grupo.Header = " $Cat ";
    $Grupo.Foreground = "#38BDF8";
    $Grupo.BorderBrush = "#3F3F46";
    $Grupo.Margin = "0,0,0,12";
    $Grupo.Padding = "8";

    $Contenedor = New-Object System.Windows.Controls.WrapPanel;
    
    foreach ($App in $Categorias[$Cat]) {
        $CB = New-Object System.Windows.Controls.CheckBox;
        $CB.Tag = $App.Id;
        $CB.ToolTip = $App.Type;
        $CB.Width = 320;
        $CB.Height = 36;
        $CB.Margin = "6";
        $CB.Foreground = "#F4F4F5";
        
        $StackCard = New-Object System.Windows.Controls.StackPanel;
        $StackCard.Orientation = "Horizontal";

        if ($App.Icon) {
            $Img = New-Object System.Windows.Controls.Image;
            $Img.Width = 18;
            $Img.Height = 18;
            $Img.Margin = "0,0,8,0";
            try {
                $Bitmap = New-Object System.Windows.Media.Imaging.BitmapImage;
                $Bitmap.BeginInit();
                $Bitmap.UriSource = [System.Uri]$App.Icon;
                $Bitmap.CacheOption = [System.Windows.Media.Imaging.BitmapCacheOption]::OnLoad;
                $Bitmap.EndInit();
                $Img.Source = $Bitmap;
            } catch {}
            $StackCard.Children.Add($Img) >$null;
        }

        $Txt = New-Object System.Windows.Controls.TextBlock;
        $Txt.Text = $App.Name;
        $Txt.VerticalAlignment = "Center";
        $Txt.FontSize = 12;
        $StackCard.Children.Add($Txt) >$null;

        $CB.Content = $StackCard;
        
        $CB.Add_Checked({ Actualizar-Contador });
        $CB.Add_Unchecked({ Actualizar-Contador });
        
        $Contenedor.Children.Add($CB) >$null;
        $ListaCheckboxes += $CB;
    }

    $Grupo.Content = $Contenedor;
    $PanelCategorias.Children.Add($Grupo) >$null;
}

$BtnSeleccionarTodo.Add_Click({
    $ListaCheckboxes.ForEach({ $_.IsChecked = $true });
    Actualizar-Contador;
});

$BtnLimpiar.Add_Click({
    $ListaCheckboxes.ForEach({ $_.IsChecked = $false });
    Actualizar-Contador;
});

# ==========================================
# 4. FUNCIONES DEL BOOTEADOR USB (ISO LOCAL)
# ==========================================
function Cargar-UnidadesUSB {
    $CmbUnidadesUsb.Items.Clear();
    $DiscosUsb = Get-Disk | Where-Object { $_.BusType -eq 'Usb' };
    foreach ($Disco in $DiscosUsb) {
        $TamanoGB = [math]::Round($Disco.Size / 1GB, 1);
        $Item = New-Object System.Windows.Controls.ComboBoxItem;
        $Item.Content = "Disco $($Disco.Number): $($Disco.FriendlyName) ($TamanoGB GB)";
        $Item.Tag = $Disco.Number;
        $CmbUnidadesUsb.Items.Add($Item) >$null;
    }
    if ($CmbUnidadesUsb.Items.Count -gt 0) {
        $CmbUnidadesUsb.SelectedIndex = 0;
    }
}

Cargar-UnidadesUSB;

$BtnRefrescarUsb.Add_Click({
    Cargar-UnidadesUSB;
    $TxtEstadoBooteo.Text = "Estado: Lista de memorias USB actualizada.";
});

$BtnBuscarIso.Add_Click({
    $Dialogo = New-Object System.Windows.Forms.OpenFileDialog;
    $Dialogo.Title = "Selecciona la imagen ISO de Windows";
    $Dialogo.Filter = "Archivos de Imagen ISO (*.iso)|*.iso|Todos los archivos (*.*)|*.*";
    if ($Dialogo.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
        $TxtRutaIso.Text = $Dialogo.FileName;
        $TxtEstadoBooteo.Text = "Estado: ISO cargada lista para bootear.";
    }
});

$BtnAbrirRufus.Add_Click({
    $RutaRufus = "$env:TEMP\rufus_portable.exe";
    if (-not (Test-Path $RutaRufus)) {
        $TxtEstadoBooteo.Text = "Estado: Descargando Rufus Portable ligero...";
        Invoke-WebRequest -Uri "https://github.com/pbatard/rufus/releases/download/v4.5/rufus-4.5p.exe" -OutFile $RutaRufus;
    }
    Start-Process -FilePath $RutaRufus;
    $TxtEstadoBooteo.Text = "Estado: Rufus Portable abierto.";
});

$BtnIniciarBooteo.Add_Click({
    $RutaIso = $TxtRutaIso.Text;
    if (-not (Test-Path $RutaIso) -or $RutaIso -like "Ningun archivo*") {
        [System.Windows.MessageBox]::Show("Primero busca y selecciona un archivo .ISO valido de tu PC.", "Falta ISO", "OK", "Warning");
        return;
    }
    if ($null -eq $CmbUnidadesUsb.SelectedItem) {
        [System.Windows.MessageBox]::Show("Selecciona una memoria USB conectada.", "Falta USB", "OK", "Warning");
        return;
    }

    $NumDisco = $CmbUnidadesUsb.SelectedItem.Tag;
    $NombreUsb = $CmbUnidadesUsb.SelectedItem.Content;
    $Esquema = if ($RbMBR.IsChecked) { "MBR" } else { "GPT" };

    $Confirmar = [System.Windows.MessageBox]::Show(
        "ATENCION! Se borrara TODA la informacion de:`n`n$NombreUsb`n`nEsquema elegido: $Esquema`nISO: $RutaIso`n`nDeseas continuar?",
        "Confirmar Formateo y Booteo", "YesNo", "Warning"
    );

    if ($Confirmar -ne "Yes") { return; }

    $Ventana.Close();

    Write-Host "`n==========================================" -ForegroundColor Cyan;
    Write-Host "INICIANDO CREACION DE USB BOOTEABLE ($Esquema)" -ForegroundColor Cyan;
    Write-Host "==========================================" -ForegroundColor Cyan;

    try {
        Write-Host "[1/5] Limpiando y preparando el Disco $NumDisco en modo $Esquema..." -ForegroundColor Yellow;
        Clear-Disk -Number $NumDisco -RemoveData -RemoveOEM -Confirm:$false -ErrorAction Stop;
        Initialize-Disk -Number $NumDisco -PartitionStyle $Esquema -ErrorAction Stop;

        Write-Host "[2/5] Creando particion activa y formateando unidad..." -ForegroundColor Yellow;
        if ($Esquema -eq "MBR") {
            $Particion = New-Partition -DiskNumber $NumDisco -UseMaximumSize -IsActive -AssignDriveLetter;
        } else {
            $Particion = New-Partition -DiskNumber $NumDisco -UseMaximumSize -AssignDriveLetter;
        }
        
        Format-Volume -Partition $Particion -FileSystem NTFS -NewFileSystemLabel "WIN_BOOT" -Confirm:$false >$null;
        $LetraUsb = $Particion.DriveLetter;

        Write-Host "[3/5] Montando imagen ISO local ($RutaIso)..." -ForegroundColor Yellow;
        $Montaje = Mount-DiskImage -ImagePath $RutaIso -PassThru;
        $LetraIso = ($Montaje | Get-Volume).DriveLetter;

        if ($Esquema -eq "MBR" -and (Test-Path "${LetraIso}:\boot\bootsect.exe")) {
            Write-Host "Instalando sector de arranque BIOS Legacy (bootsect /nt60)..." -ForegroundColor Cyan;
            Start-Process -FilePath "${LetraIso}:\boot\bootsect.exe" -ArgumentList "/nt60 ${LetraUsb}: /mbr" -NoNewWindow -Wait;
        }

        Write-Host "[4/5] Copiando todos los archivos de Windows al USB (${LetraUsb}:)... Esto tomara unos minutos." -ForegroundColor Yellow;
        robocopy "${LetraIso}:\" "${LetraUsb}:\" /E /J /NFL /NDL /NJH /NJS /NC /NS

        if ($ChkBypassWin11.IsChecked) {
            Write-Host "Aplicando archivo de salto de requisitos TPM 2.0 / SecureBoot en el USB..." -ForegroundColor Cyan;
            $RegBypass = @(
                'Windows Registry Editor Version 5.00'
                ''
                '[HKEY_LOCAL_MACHINE\SYSTEM\Setup\LabConfig]'
                '"BypassTPMCheck"=dword:00000001'
                '"BypassSecureBootCheck"=dword:00000001'
                '"BypassRAMCheck"=dword:00000001'
                '"BypassStorageCheck"=dword:00000001'
                '"BypassCPUCheck"=dword:00000001'
            ) -join "`r`n";
            $RegBypass | Out-File -FilePath "${LetraUsb}:\Bypass_Win11_TPM.reg" -Encoding ASCII;
        }

        Write-Host "[5/5] Desmontando imagen ISO..." -ForegroundColor Yellow;
        Dismount-DiskImage -ImagePath $RutaIso >$null;

        Write-Host "`nMEMORIA USB BOOTEABLE CREADA CON EXITO EN ${LetraUsb}: ($Esquema)!" -ForegroundColor Green;
    } catch {
        Write-Host "Ocurrio un error durante la creacion del USB: $($_.Exception.Message)" -ForegroundColor Red;
        if ($RutaIso) { Dismount-DiskImage -ImagePath $RutaIso -ErrorAction SilentlyContinue >$null; }
    }
});

# ==========================================
# 5. ACCION DEL BOTON INSTALAR (PROGRAMAS)
# ==========================================
$BtnInstalar.Add_Click({
    $Seleccionados =$ListaCheckboxes.Where({ $_.IsChecked -eq$true });
    
    if ($Seleccionados.Count -eq 0) {
        [System.Windows.MessageBox]::Show("Marca al menos un programa para instalar.", "Aviso");
        return;
    }

    $Ventana.Close();

    foreach ($Item in $Seleccionados) {$NombreApp = "";
        foreach ($child in $Item.Content.Children) {
            if ($child -is [System.Windows.Controls.TextBlock]) {
                $NombreApp =$child.Text;
            }
        }
        
        Write-Host "`n==========================================" -ForegroundColor DarkGray;
        Write-Host "Ejecutando: $NombreApp..." -ForegroundColor Cyan;
        
        if ($Item.ToolTip -eq "Url") {
            $UrlFinal = $Item.Tag;
            if ($UrlFinal -like "*drive.google.com*") {
                if ($UrlFinal -match "/d/([a-zA-Z0-9_-]+)") {
                    $FileId = $Matches[1];
                    $UrlFinal = "https://drive.google.com/uc?export=download&id=$FileId";
                }
            }

            $RutaDestino = "$env:TEMP\Instalador_$(Get-Random).exe";
            Write-Host "Descargando instalador de $NombreApp..." -ForegroundColor Yellow;
            Invoke-WebRequest -Uri $UrlFinal -OutFile $RutaDestino;
            Start-Process -FilePath $RutaDestino -Wait;
        } elseif ($Item.ToolTip -eq "DescargaEscritorio") {
            $NombreArchivo = [System.IO.Path]::GetFileName($Item.Tag);
            $RutaEscritorio = [Environment]::GetFolderPath("Desktop");
            $ArchivoDestino = "$RutaEscritorio\$NombreArchivo";
            Write-Host "Descargando $NombreArchivo al Escritorio..." -ForegroundColor Yellow;
            Invoke-WebRequest -Uri $Item.Tag -OutFile $ArchivoDestino;
            Write-Host "Guardado con exito en el Escritorio!" -ForegroundColor Green;
        } elseif ($Item.ToolTip -eq "Script") {
            Invoke-RestMethod -Uri $Item.Tag | Invoke-Expression;
        } else {
            winget install --id $Item.Tag -e --accept-package-agreements --accept-source-agreements;
        }
    }
    
    Write-Host "`n==========================================" -ForegroundColor DarkGray;
    Write-Host "Proceso completado con exito!" -ForegroundColor Green;
});
    
# Mostrar la ventana
$Ventana.ShowDialog() >$null;
