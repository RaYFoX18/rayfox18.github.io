$Reader = New-Object System.Xml.XmlNodeReader $XAML;
$Ventana = [Windows.Markup.XamlReader]::Load($Reader);
$PanelCategorias =$Ventana.FindName("PanelCategorias");
$BtnInstalar =$Ventana.FindName("BtnInstalar");
$BtnSeleccionarTodo =$Ventana.FindName("BtnSeleccionarTodo");
$BtnLimpiar =$Ventana.FindName("BtnLimpiar");
$TxtContador =$Ventana.FindName("TxtContador");

$ListaCheckboxes = @();

# Función para actualizar el contador en tiempo real
function Actualizar-Contador {
    $Total = ($ListaCheckboxes | Where-Object { $_.IsChecked -eq$true }).Count;
    $TxtContador.Text = "Seleccionados: $Total";
}

# 4. GENERAR CATEGORIAS Y TARJETAS EN GRID
foreach ($Cat in ($Categorias.Keys)) {$Grupo = New-Object System.Windows.Controls.GroupBox;
    $Grupo.Header = " $Cat ";
    $Grupo.Foreground = "#38BDF8";
    $Grupo.BorderBrush = "#3F3F46";
    $Grupo.Margin = "0,0,0,12";
    $Grupo.Padding = "8";

    $Contenedor = New-Object System.Windows.Controls.WrapPanel;
    
    foreach ($App in ($Categorias[$Cat])) {$CB = New-Object System.Windows.Controls.CheckBox;
        $CB.Content =$App.Name;
        $CB.Tag =$App.Id;
        $CB.ToolTip =$App.Type;
        $CB.Foreground = "#F4F4F5";
        $CB.Width = 205;
        $CB.Height = 32;
        $CB.Margin = "6";
        $CB.FontSize = 13;
        
        # Evento para actualizar el contador al marcar/desmarcar
        $CB.Add_Checked({ Actualizar-Contador });$CB.Add_Unchecked({ Actualizar-Contador });
        
        $Contenedor.Children.Add($CB) | Out-Null;
        $ListaCheckboxes +=$CB;
    }

    $Grupo.Content =$Contenedor;
    $PanelCategorias.Children.Add($Grupo) | Out-Null;
}

# Acciones de los botones del Sidebar
$BtnSeleccionarTodo.Add_Click({
    foreach ($cb in $ListaCheckboxes) { 
        $cb.IsChecked =$true; 
    }
    Actualizar-Contador;
});

$BtnLimpiar.Add_Click({
    foreach ($cb in $ListaCheckboxes) { 
        $cb.IsChecked =$false; 
    }
    Actualizar-Contador;
});

# 5. ACCION DEL BOTON INSTALAR
$BtnInstalar.Add_Click({
    $Seleccionados =$ListaCheckboxes | Where-Object { $_.IsChecked -eq$true };
    
    if ($Seleccionados.Count -eq 0) {
        [System.Windows.MessageBox]::Show("Marca al menos un programa para instalar.", "Aviso");
        return;
    }

    $Ventana.Close();

    foreach ($Item in $Seleccionados) {
        Write-Host "`n==========================================" -ForegroundColor DarkGray;
        Write-Host "Instalando: $($Item.Content)..." -ForegroundColor Cyan;
        
        If ($Item.ToolTip -eq "Office") {
            Instalar-Office -Tipo $Item.Tag;
        } elseif ($Item.ToolTip -eq "Url") {
            $NombreArchivo = [System.IO.Path]::GetFileName($Item.Tag);
            $RutaDestino = "$env:TEMP\$NombreArchivo";
            Invoke-WebRequest -Uri $Item.Tag -OutFile $RutaDestino;
            Start-Process -FilePath $RutaDestino -Wait;
        } elseif ($Item.ToolTip -eq "ArtCraft") {
            Start-Process $Item.Tag;
            Write-Host "Abriendo la página oficial de ArtCraft..." -ForegroundColor Green;
        } else {
            winget install --id $Item.Tag -e --accept-package-agreements --accept-source-agreements;
        }
    }
    
    Write-Host "`n==========================================" -ForegroundColor DarkGray;
    Write-Host "¡Proceso completado con exito!" -ForegroundColor Green;
});

# Mostrar la ventana
$Ventana.ShowDialog() | Out-Null;
