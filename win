# 2. FUNCION PARA INSTALAR OFFICE DESDE IMAGEN OFFLINE (.IMG) (2021 y 2024)
function Instalar-Office ($Tipo) {
    # 1. Definir enlace según la versión (Sin Office 365)
    if ($Tipo -eq "OFFICE_2024") {
        $VersionName = "Office 2024";
        $ImgUrl = "https://officecdn.microsoft.com/db/492350f6-3a01-4f97-b9c0-c7c6ddf67d60/media/es-es/ProPlus2024Retail.img";
    } elseif ($Tipo -eq "OFFICE_2021") {
        $VersionName = "Office 2021";
        $ImgUrl = "https://officecdn.microsoft.com/db/492350f6-3a01-4f97-b9c0-c7c6ddf67d60/media/es-es/ProPlus2021Retail.img";
    } else {
        Write-Host "Opción inválida o versión no soportada." -ForegroundColor Red;
        return;
    }

    $ImgPath = "$env:TEMP\OfficeOffline.img";

    Write-Host "Descargando instalador completo de $VersionName (Esto puede tardar dependiendo del internet)..." -ForegroundColor Yellow;
    
    # 2. Descargar el archivo .img desde el CDN oficial
    Invoke-WebRequest -Uri $ImgUrl -OutFile $ImgPath;

    if (Test-Path $ImgPath) {
        Write-Host "Montando disco virtual..." -ForegroundColor Yellow;
        
        # 3. Montar la imagen virtual y obtener la letra del disco asignada
        $Montaje = Mount-DiskImage -ImagePath $ImgPath -PassThru;
        $LetraDisco = ($Montaje | Get-Volume).DriveLetter;
        $SetupExe = "${LetraDisco}:\Setup.exe";

        if (Test-Path $SetupExe) {
            Write-Host "Instalando $VersionName..." -ForegroundColor Yellow;
            # 4. Ejecutar el instalador
            Start-Process -FilePath $SetupExe -Wait;
        } else {
            Write-Host "Error: No se encontró el Setup.exe en la imagen montada." -ForegroundColor Red;
        }

        # 5. Desmontar el disco virtual y limpiar el archivo pesado
        Write-Host "Limpiando archivos temporales..." -ForegroundColor Yellow;
        Dismount-DiskImage -ImagePath $ImgPath >$null;
        Remove-Item -Path $ImgPath -Force;
        
    } else {
        Write-Host "Error crítico: No se pudo descargar el archivo .img." -ForegroundColor Red;
    }
}

