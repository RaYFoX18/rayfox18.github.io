$BtnIniciarBooteo.Add_Click({
    $RutaIso = $TxtRutaIso.Text;
    if (-not (Test-Path $RutaIso) -or $RutaIso -like "Ningun archivo*") {
        [System.Windows.MessageBox]::Show("Primero busca y selecciona un archivo .ISO valido de tu PC.", "Falta ISO", "OK", "Warning");
        return;
    }
    if ($null -eq $CmbUnidadesUsb.SelectedItem) {
        [System.Windows.MessageBox]::Show("Selecciona una memoria USB conectada.", "Falta USB", "OK", "Warning");
        return;
    }

    $NumDisco = $CmbUnidadesUsb.SelectedItem.Tag;
    $NombreUsb = $CmbUnidadesUsb.SelectedItem.Content;
    $Esquema = if ($RbMBR.IsChecked) { "MBR" } else { "GPT" };

    $Confirmar = [System.Windows.MessageBox]::Show(
        "ATENCION! Se borrara TODA la informacion de:`n`n$NombreUsb`n`nEsquema elegido: $Esquema`nISO: $RutaIso`n`nDeseas continuar?",
        "Confirmar Formateo y Booteo", "YesNo", "Warning"
    );

    if ($Confirmar -ne "Yes") { return; }

    $ProcUI = Abrir-VentanaRFX18 "Creacion de unidad USB Booteable ($Esquema)";
    $ProcUI.Window.Show();
    Actualizar-ProgresoRFX18 $ProcUI "Limpiando y preparando $NombreUsb en formato $Esquema..." $null 15;

    try {
        Clear-Disk -Number $NumDisco -RemoveData -RemoveOEM -Confirm:$false -ErrorAction Stop;
        Initialize-Disk -Number $NumDisco -PartitionStyle $Esquema -ErrorAction Stop;

        Actualizar-ProgresoRFX18 $ProcUI "Creando particion activa y aplicando formato NTFS..." $null 30;
        if ($Esquema -eq "MBR") {
            $Particion = New-Partition -DiskNumber $NumDisco -UseMaximumSize -IsActive -AssignDriveLetter;
        } else {
            $Particion = New-Partition -DiskNumber $NumDisco -UseMaximumSize -AssignDriveLetter;
        }
        
        Format-Volume -Partition $Particion -FileSystem NTFS -NewFileSystemLabel "WIN_BOOT" -Confirm:$false >$null;
        $LetraUsb =$Particion.DriveLetter;

        Actualizar-ProgresoRFX18 $ProcUI "Montando imagen ISO local ($RutaIso)..." $null 45;
        $Montaje = Mount-DiskImage -ImagePath $RutaIso -PassThru;
        $VolumenIso = Get-Volume -DiskImage $Montaje;
        $LetraIso =$VolumenIso.DriveLetter;

        if ($Esquema -eq "MBR" -and (Test-Path "${LetraIso}:\boot\bootsect.exe")) {
            Actualizar-ProgresoRFX18 $ProcUI "Configurando sector de arranque BIOS Legacy (bootsect /nt60)..." $null 60;
            Ejecutar-ProcesoSinCongelar $ProcUI "${LetraIso}:\boot\bootsect.exe" "/nt60 ${LetraUsb}: /mbr";
        }

        Actualizar-ProgresoRFX18 $ProcUI "Desempaquetando y copiando archivos del sistema a ${LetraUsb}:\..." $null 65;
        Ejecutar-ProcesoSinCongelar $ProcUI "robocopy.exe" "${LetraIso}:\ ${LetraUsb}:\ /E /J /NFL /NDL /NJH /NJS /NC /NS";

        if ($ChkBypassWin11.IsChecked) {
            Actualizar-ProgresoRFX18 $ProcUI "Aplicando optimizaciones de Windows 11 (Bypass TPM 2.0 / SecureBoot)..." $null 90;
            $RegBypass = @(
                'Windows Registry Editor Version 5.00'
                ''
                '[HKEY_LOCAL_MACHINE\SYSTEM\Setup\LabConfig]'
                '"BypassTPMCheck"=dword:00000001'
                '"BypassSecureBootCheck"=dword:00000001'
                '"BypassRAMCheck"=dword:00000001'
                '"BypassStorageCheck"=dword:00000001'
                '"BypassCPUCheck"=dword:00000001'
            );
            [System.IO.File]::WriteAllLines("${LetraUsb}:\Bypass_Win11_TPM.reg", $RegBypass);
        }

        Dismount-DiskImage -ImagePath $RutaIso >$null;
        Actualizar-ProgresoRFX18 $ProcUI "Memoria USB Booteable finalizada con exito en ${LetraUsb}: ($Esquema)." "Proceso finalizado correctamente" 100;
    } catch {
        Actualizar-ProgresoRFX18 $ProcUI "Error durante el proceso: $($_.Exception.Message)" "Error en la operacion" 100;
        if ($RutaIso) { Dismount-DiskImage -ImagePath $RutaIso -ErrorAction SilentlyContinue >$null; }
    }

    $ProcUI.BtnCerrar.Visibility = "Visible";
});

$BtnInstalar.Add_Click({
    $Seleccionados = @($ListaCheckboxes | Where-Object { $_.IsChecked -eq $true });
    
    if ($Seleccionados.Count -eq 0) {
        [System.Windows.MessageBox]::Show("Marca al menos un programa para instalar.", "Aviso");
        return;
    }

    $ColaProcesamiento = @();
    foreach ($Item in $Seleccionados) {$Nom = "";
        foreach ($child in $Item.Content.Children) {
            if ($child -is [System.Windows.Controls.TextBlock]) {
                $Nom =$child.Text;
            }
        }
        $TipoApp = [string]$Item.ToolTip;
        $UrlOId  = [string]$Item.Tag;

        $ColaProcesamiento += [PSCustomObject]@{
            Nombre = $Nom
            Tipo   = $TipoApp
            IdUrl  = $UrlOId
            EsComp = ($TipoApp -eq "DescargaEscritorio")
        };
    }

    $ColaProcesamiento = @($ColaProcesamiento | Sort-Object { if ($_.EsComp) { 1 } else { 0 } });

    $ProcUI = Abrir-VentanaRFX18 "Progreso de instalacion y mantenimiento";
    $ProcUI.Window.Show();
    Actualizar-UI-WPF;

    $TotalApps =$ColaProcesamiento.Count;
    $ContadorActual = 0;
    $SeDescargaronComprimidos =$false;

    $CarpetaBasePortatiles = "C:\HerramientasPortatiles";
    if (-not (Test-Path $CarpetaBasePortatiles)) {
        New-Item -ItemType Directory -Path $CarpetaBasePortatiles -Force | Out-Null;
    }

    foreach ($App in $ColaProcesamiento) {$ContadorActual++;
        $NombreApp =$App.Nombre;
        
        $PorcInicio = [math]::Round((($ContadorActual - 1) /$TotalApps) * 100);
        $PorcMedio  = [math]::Round((($ContadorActual - 0.4) / $TotalApps) * 100);$PorcFin    = [math]::Round(($ContadorActual / $TotalApps) * 100);

        Actualizar-ProgresoRFX18 $ProcUI "Procesando: $NombreApp..." "Instalando [$ContadorActual de$TotalApps]: $NombreApp" $PorcInicio;

        if ($App.Tipo -eq "Url") {
            $RutaDestino = "$env:TEMP\Instalador_$(Get-Random).exe";
            Actualizar-ProgresoRFX18 $ProcUI "Descargando instalador de $NombreApp..." $null $PorcMedio;

            $Ok = Descargar-ArchivoConTimeout $ProcUI $App.IdUrl $RutaDestino $NombreApp;

            if ($Ok) {
                Actualizar-ProgresoRFX18 $ProcUI "Iniciando instalador de $NombreApp..." $null $PorcMedio;
                Start-Process -FilePath $RutaDestino;
                Actualizar-ProgresoRFX18 $ProcUI "$NombreApp iniciado correctamente." $null $PorcFin;
            } else {
                Actualizar-ProgresoRFX18 $ProcUI "No se pudo descargar $NombreApp (omitido)." $null $PorcFin;
            }

        } elseif ($App.Tipo -eq "DescargaEscritorio") {
            $EsComprimido = ($App.IdUrl -like "*.zip*" -or $App.IdUrl -like "*.rar*");

            if ($EsComprimido) {$ArchivoDestino = Join-Path $CarpetaBasePortatiles "$NombreApp.zip";
                Actualizar-ProgresoRFX18 $ProcUI "Descargando $NombreApp a HerramientasPortatiles..." $null $PorcMedio;
            } else {
                $RutaEscritorio = [Environment]::GetFolderPath("Desktop");
                $ArchivoDestino = Join-Path $RutaEscritorio "$NombreApp.exe";
                Actualizar-ProgresoRFX18 $ProcUI "Descargando $NombreApp al Escritorio..." $null $PorcMedio;
            }

            $Ok = Descargar-ArchivoConTimeout $ProcUI $App.IdUrl $ArchivoDestino $NombreApp;

            if ($Ok) {
                if ($EsComprimido) {
                    $SeDescargaronComprimidos =$true;
                    Actualizar-ProgresoRFX18 $ProcUI "$NombreApp guardado en HerramientasPortatiles." $null $PorcFin;
                } else {
                    Actualizar-ProgresoRFX18 $ProcUI "$NombreApp guardado en el Escritorio." $null $PorcFin;
                }
            } else {
                Actualizar-ProgresoRFX18 $ProcUI "Fallo la descarga de $NombreApp." $null $PorcFin;
            }

        } elseif ($App.Tipo -eq "Script") {
            Actualizar-ProgresoRFX18 $ProcUI "Ejecutando script para $NombreApp..." $null $PorcMedio;
            $CodigoRemoto = Invoke-RestMethod -Uri$App.IdUrl;
            Invoke-Expression $CodigoRemoto;
            Actualizar-ProgresoRFX18 $ProcUI "Script finalizado." $null $PorcFin;

        } else {
            Actualizar-ProgresoRFX18 $ProcUI "Instalando $NombreApp mediante Winget..." $null $PorcMedio;
            $ParametrosWinget = "install --id $($App.IdUrl) -e --silent --disable-interactivity --accept-package-agreements --accept-source-agreements --force";
            Ejecutar-ProcesoSinCongelar $ProcUI "winget.exe" $ParametrosWinget;
            Actualizar-ProgresoRFX18 $ProcUI "$NombreApp completado via Winget." $null $PorcFin;
        }
    }
    
    Actualizar-ProgresoRFX18 $ProcUI "Proceso de instalacion finalizado con exito." "Finalizado" 100;
    
    $RutaPdfCraft = "C:\HerramientasPortatiles\PDFCraft.zip";
    if (Test-Path $RutaPdfCraft) {
        [System.Windows.MessageBox]::Show(
            "Se descargo correctamente tu archivo en:`n`nC:\HerramientasPortatiles`n`nSe abrira la carpeta para que puedas descomprimirlo.",
            "Archivo Listo", "OK", "Information"
        );
        Start-Process "explorer.exe" "/select,`"$RutaPdfCraft`"";
    } elseif (Test-Path "C:\HerramientasPortatiles") {
        Start-Process "explorer.exe" "C:\HerramientasPortatiles";
    }

    $ProcUI.BtnCerrar.Visibility = "Visible";
});


# --- Agilizar Windows: acciones con registro y confirmacion ---
$BtnLimpiarTemp = $Ventana.FindName("BtnLimpiarTemp")
$BtnPapelera = $Ventana.FindName("BtnPapelera")
$BtnDNS = $Ventana.FindName("BtnDNS")
$BtnDiagnostico = $Ventana.FindName("BtnDiagnostico")
$BtnOptimizar = $Ventana.FindName("BtnOptimizar")
$BtnReparar = $Ventana.FindName("BtnReparar")
$TxtEstadoAgilizar = $Ventana.FindName("TxtEstadoAgilizar")
$TxtLogAgilizar = $Ventana.FindName("TxtLogAgilizar")

$CarpetaInformesRFX = Join-Path ([Environment]::GetFolderPath("MyDocuments")) "RFX18-Informes"
if (-not (Test-Path -LiteralPath $CarpetaInformesRFX)) {
    New-Item -ItemType Directory -Path $CarpetaInformesRFX -Force | Out-Null
}
$RutaLogAgilizar = Join-Path $CarpetaInformesRFX ("Agilizar-Windows-" + (Get-Date -Format "yyyyMMdd-HHmmss") + ".csv")
$RegistrosAgilizar = New-Object System.Collections.Generic.List[object]

function Registrar-AgilizarRFX18 {
    param([string]$Accion, [string]$Resultado, [string]$Detalle)
    $Registro = [PSCustomObject]@{
        Fecha = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
        Accion = $Accion
        Resultado = $Resultado
        Detalle = $Detalle
    }
    $RegistrosAgilizar.Add($Registro)
    $Registro | Export-Csv -LiteralPath $RutaLogAgilizar -NoTypeInformation -Encoding UTF8 -Append
    if ($TxtLogAgilizar) {
        $TxtLogAgilizar.AppendText("[$($Registro.Fecha)] $Accion - $Resultado`: $Detalle`r`n")
        $TxtLogAgilizar.ScrollToEnd()
    }
    if ($TxtEstadoAgilizar) { $TxtEstadoAgilizar.Text = "$Accion - $Resultado. Informe: $RutaLogAgilizar" }
}

$BtnLimpiarTemp.Add_Click({
    $Confirmar = [System.Windows.MessageBox]::Show(
        "Se eliminaran archivos temporales de tu usuario. Los archivos en uso se omitiran. ¿Continuar?",
        "Confirmar limpieza", "YesNo", "Warning")
    if ($Confirmar -ne "Yes") { return }
    try {
        $TempUsuario = [IO.Path]::GetTempPath()
        $Antes = (Get-ChildItem -LiteralPath $TempUsuario -Force -ErrorAction SilentlyContinue | Measure-Object).Count
        Get-ChildItem -LiteralPath $TempUsuario -Force -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue
        Registrar-AgilizarRFX18 "Limpiar temporales" "Completado" "Se intento limpiar $TempUsuario; elementos encontrados antes: $Antes. Los archivos bloqueados se omitieron."
    } catch {
        Registrar-AgilizarRFX18 "Limpiar temporales" "Error" $_.Exception.Message
    }
})

$BtnPapelera.Add_Click({
    $Confirmar = [System.Windows.MessageBox]::Show(
        "Esto vaciara la Papelera de reciclaje y eliminara sus elementos. ¿Deseas continuar?",
        "Confirmar vaciado de papelera", "YesNo", "Warning")
    if ($Confirmar -ne "Yes") { return }
    try {
        Clear-RecycleBin -Force -ErrorAction Stop
        Registrar-AgilizarRFX18 "Vaciar papelera" "Completado" "Se ejecuto Clear-RecycleBin."
    } catch {
        Registrar-AgilizarRFX18 "Vaciar papelera" "Error" $_.Exception.Message
    }
})

$BtnDNS.Add_Click({
    try {
        $SalidaDNS = ipconfig.exe /flushdns 2>&1 | Out-String
        Registrar-AgilizarRFX18 "Limpiar cache DNS" "Ejecutado" ($SalidaDNS.Trim())
    } catch {
        Registrar-AgilizarRFX18 "Limpiar cache DNS" "Error" $_.Exception.Message
    }
})

$BtnDiagnostico.Add_Click({
    try {
        $OS = Get-CimInstance Win32_OperatingSystem -ErrorAction Stop
        $CPU = Get-CimInstance Win32_Processor -ErrorAction SilentlyContinue | Select-Object -First 1
        $DiscoC = Get-CimInstance Win32_LogicalDisk -Filter "DeviceID='C:'" -ErrorAction Stop
        $LibreGB = [math]::Round($DiscoC.FreeSpace / 1GB, 2)
        $TotalGB = [math]::Round($DiscoC.Size / 1GB, 2)
        $RAMLibreGB = [math]::Round($OS.FreePhysicalMemory / 1MB, 2)
        $Detalle = "Windows: $($OS.Caption); CPU: $($CPU.Name); RAM libre aproximada: $RAMLibreGB GB; C: libre $LibreGB GB de $TotalGB GB."
        Registrar-AgilizarRFX18 "Diagnostico del sistema" "Completado" $Detalle
        [System.Windows.MessageBox]::Show($Detalle, "Diagnóstico RFX18", "OK", "Information") | Out-Null
    } catch {
        Registrar-AgilizarRFX18 "Diagnostico del sistema" "Error" $_.Exception.Message
    }
})

$BtnOptimizar.Add_Click({
    $Confirmar = [System.Windows.MessageBox]::Show(
        "Se ejecutara Optimize-Volume en C: con la optimizacion recomendada por Windows. ¿Continuar?",
        "Confirmar optimización", "YesNo", "Warning")
    if ($Confirmar -ne "Yes") { return }
    try {
        Optimize-Volume -DriveLetter C -Verbose -ErrorAction Stop 4>&1 | Out-String | ForEach-Object { $DetalleOpt = $_ }
        Registrar-AgilizarRFX18 "Optimizar unidad C:" "Completado" "Se solicito a Windows optimizar C: mediante Optimize-Volume. Revisa el estado del volumen si necesitas confirmar el resultado detallado."
    } catch {
        Registrar-AgilizarRFX18 "Optimizar unidad C:" "Error" $_.Exception.Message
    }
})

$BtnReparar.Add_Click({
    $Confirmar = [System.Windows.MessageBox]::Show(
        "DISM y SFC comprobaran y repararan archivos del sistema. Puede tardar bastante. Se recomienda ejecutar RFX18 como administrador. ¿Continuar?",
        "Confirmar reparación de Windows", "YesNo", "Warning")
    if ($Confirmar -ne "Yes") { return }
    try {
        $TxtEstadoAgilizar.Text = "Ejecutando DISM /Online /Cleanup-Image /RestoreHealth..."
        $DISM = Start-Process -FilePath "dism.exe" -ArgumentList "/Online /Cleanup-Image /RestoreHealth" -Wait -PassThru -NoNewWindow
        Registrar-AgilizarRFX18 "DISM RestoreHealth" $(if ($DISM.ExitCode -eq 0) { "Completado" } else { "Código $($DISM.ExitCode)" }) "DISM terminó. Código de salida: $($DISM.ExitCode)."
        $TxtEstadoAgilizar.Text = "Ejecutando sfc /scannow..."
        $SFC = Start-Process -FilePath "sfc.exe" -ArgumentList "/scannow" -Wait -PassThru -NoNewWindow
        Registrar-AgilizarRFX18 "SFC scannow" $(if ($SFC.ExitCode -eq 0) { "Completado" } else { "Código $($SFC.ExitCode)" }) "SFC terminó. Código de salida: $($SFC.ExitCode)."
    } catch {
        Registrar-AgilizarRFX18 "Reparar Windows" "Error" $_.Exception.Message
    }
})
# --- Fin Agilizar Windows ---

$Ventana.ShowDialog() >$null;
