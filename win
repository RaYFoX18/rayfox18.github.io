# 2. FUNCION PARA INSTALAR OFFICE EN ESPAÑOL
function Instalar-Office ($Tipo) {
    $RutaTemp = "$env:TEMP\office_setup";
    if (!(Test-Path $RutaTemp)) { New-Item -ItemType Directory -Path $RutaTemp >$null; }

    if ($Tipo -eq "OFFICE_2024") {
        $Canal = "PerpetualVL2024";
        $Producto = "ProPlus2024Volume";
    } elseif ($Tipo -eq "OFFICE_2021") {
        $Canal = "PerpetualVL2021";
        $Producto = "ProPlus2021Volume";
    } else {
        $Canal = "Current";
        $Producto = "O365ProPlusRetail";
    }

    $XML = @"
<Configuration>
  <Add OfficeClientEdition="64" Channel="$Canal">
    <Product ID="$Producto">
      <Language ID="es-es" />
    </Product>
  </Add>
  <Display Level="Full" AcceptEULA="TRUE" />
</Configuration>
"@;
    $ArchivoXML = "$RutaTemp\config.xml";
    [System.IO.File]::WriteAllText($ArchivoXML,$XML);

    Write-Host "Preparando instalador oficial de Microsoft ($Producto)..." -ForegroundColor Yellow;
    winget install --id Microsoft.OfficeDeploymentTool -e --accept-package-agreements --accept-source-agreements --location $RutaTemp >$null;

    $SetupExe = (Get-ChildItem -Path$RutaTemp -Filter "setup.exe" -Recurse)[0];
    if ($SetupExe) {
        Start-Process -FilePath $SetupExe.FullName -ArgumentList "/configure `"$ArchivoXML`"" -Wait;
    }
}

