function Actualizar-ProgresoRFX18 ($UI,$MensajeLinea, $Subtitulo,$Porcentaje) {
    if ($Subtitulo) { $UI.Subtitulo.Text =$Subtitulo; }
    if ($null -ne $Porcentaje) {
        $Valor = [math]::Round($Porcentaje);
        $UI.Barra.Value =$Valor;
        $SimboloPorc = [char]37;
        $UI.Porcentaje.Text = "$Valor$SimboloPorc Completado";
        if ($Valor -lt 18) {$UI.Porcentaje.Foreground = "#29C5F6";
        } else {
            $UI.Porcentaje.Foreground = "#05080C";
        }
    }
    if ($MensajeLinea) {$TxtLinea = New-Object System.Windows.Controls.TextBlock;
        $TxtLinea.Text =$MensajeLinea;
        $TxtLinea.FontSize = 15;
        $TxtLinea.Margin = "0,2,0,2";
        if ($UI.EsCian) {$TxtLinea.Foreground = "#29C5F6";
            $UI.EsCian =$false;
        } else {
            $TxtLinea.Foreground = "#9CA3AF";
            $UI.EsCian =$true;
        }
        $UI.PanelLogs.Children.Add($TxtLinea) >$null;
        $UI.Scroll.ScrollToEnd();
    }
    Actualizar-UI-WPF;
}

function Ejecutar-ProcesoSinCongelar ($UI,$FilePath, $ArgumentList) {$Psi = New-Object System.Diagnostics.ProcessStartInfo;
    $Psi.FileName =$FilePath;
    $Psi.Arguments =$ArgumentList;
    $Psi.UseShellExecute =$false;
    $Psi.CreateNoWindow =$true;
    $Psi.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Hidden;

    $Proc = [System.Diagnostics.Process]::Start($Psi);
    
    while (-not $Proc.HasExited) {
        Actualizar-UI-WPF;
        Start-Sleep -Milliseconds 150;
    }
}

function Descargar-ArchivoConTimeout ($UI, $Url, $Destino, $Nombre) {
    $Proceso = $null

    try {
        $DirectorioPadre = Split-Path -Path $Destino -Parent
        if (-not (Test-Path -LiteralPath $DirectorioPadre)) {
            New-Item -ItemType Directory -Path $DirectorioPadre -Force -ErrorAction Stop | Out-Null
        }

        if (Test-Path -LiteralPath $Destino) {
            Remove-Item -LiteralPath $Destino -Force -ErrorAction SilentlyContinue
        }

        if ([string]::IsNullOrWhiteSpace($Url)) {
            throw 'La URL de descarga esta vacia.'
        }

        # curl comprueba errores HTTP y sigue redirecciones de GitHub Releases.
        $Psi = New-Object System.Diagnostics.ProcessStartInfo
        $Psi.FileName = 'curl.exe'
        $Psi.Arguments = '--fail --location --silent --show-error --user-agent "Mozilla/5.0" --connect-timeout 30 --max-time 300 --output "' + $Destino + '" "' + $Url + '"'
        $Psi.UseShellExecute = $false
        $Psi.CreateNoWindow = $true
        $Psi.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Hidden

        $Proceso = [System.Diagnostics.Process]::Start($Psi)
        while (-not $Proceso.HasExited) {
            if (Test-Path -LiteralPath $Destino) {
                $ArchivoTemporal = Get-Item -LiteralPath $Destino -ErrorAction SilentlyContinue
                if ($ArchivoTemporal) {
                    $MbActuales = [math]::Round(($ArchivoTemporal.Length / 1MB), 1)
                    Actualizar-ProgresoRFX18 $UI $null "Descargando $Nombre`: $MbActuales MB recibidos..." $null
                }
            }
            Actualizar-UI-WPF
            Start-Sleep -Milliseconds 200
        }

        if ($Proceso.ExitCode -ne 0) {
            throw "curl.exe fallo con codigo $($Proceso.ExitCode). Verifica el enlace, la conexion y que el archivo exista en GitHub."
        }

        if (-not (Test-Path -LiteralPath $Destino)) {
            throw 'La descarga termino, pero no se creo el archivo.'
        }

        $Archivo = Get-Item -LiteralPath $Destino -ErrorAction Stop
        if ($Archivo.Length -le 1MB) {
            throw "El archivo descargado solo pesa $([math]::Round($Archivo.Length / 1KB, 1)) KB. Puede ser una pagina de error en lugar del archivo esperado."
        }

        # Si la descarga es ZIP, comprobar que se pueda abrir como archivo comprimido.
        if ([System.IO.Path]::GetExtension($Destino) -ieq '.zip') {
            Add-Type -AssemblyName System.IO.Compression.FileSystem -ErrorAction SilentlyContinue
            try {
                $Zip = [System.IO.Compression.ZipFile]::OpenRead($Destino)
                $Zip.Dispose()
            }
            catch {
                throw 'El archivo recibido no parece ser un ZIP valido o esta incompleto.'
            }
        }

        Actualizar-ProgresoRFX18 $UI "$Nombre descargado correctamente." 'Descarga finalizada' 100
        return $true
    }
    catch {
        $MensajeError = $_.Exception.Message
        Write-Warning "Error descargando ${Nombre}: $MensajeError"
        Actualizar-ProgresoRFX18 $UI "Error descargando ${Nombre}: $MensajeError" 'Error de descarga' $null

        if (Test-Path -LiteralPath $Destino) {
            Remove-Item -LiteralPath $Destino -Force -ErrorAction SilentlyContinue
        }
        return $false
    }
    finally {
        if ($Proceso) { $Proceso.Dispose() }
    }
}

